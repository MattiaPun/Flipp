# ---- Server ----
# Port the container listens on.
PORT=3000
# Public URL users reach Flipp at (no trailing slash). Used for the OIDC redirect URI, CSRF origin
# checks and the cookie Secure flag. Set this whenever you run behind a reverse proxy.
PUBLIC_URL=https://flipp.example.com
# Which proxies to trust for X-Forwarded-* (Express "trust proxy" syntax).
# Default trusts loopback + private networks (typical Docker / LAN reverse proxy).
#TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Storage ----
# Empty = embedded SQLite in WAL mode at /data/Flipp.db (uploads always go to /data/uploads).
# For PostgreSQL: postgres://user:password@host:5432/flipp
DATABASE_URL=
#DATA_DIR=/data

# ---- Security ----
# Long random string; signs SSO login state and keys session hashes. Generate with: openssl rand -hex 32
# If empty, a secret is generated and stored in the database on first boot.
JWT_SECRET=

# ---- Accounts ----
# false = only invite links, admin-created accounts, or SSO can onboard new users.
# Admins can also flip this at runtime from the Admin page.
ALLOW_REGISTRATION=true

# ---- OpenID Connect (optional) ----
# Works with Authentik, Authelia, Keycloak, Google, Zitadel, … Redirect URI to register at the IdP:
#   ${PUBLIC_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Label for the login button ("Continue with …").
OIDC_NAME=SSO
# client_secret_basic (default) or client_secret_post
#OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Create accounts for unknown SSO users (default true). false = SSO only for pre-existing / linked users.
#OIDC_ALLOW_SIGNUP=true
# Users whose "groups" claim contains this value become admins (add the "groups" scope if your IdP needs it).
#OIDC_ADMIN_GROUP=flipp-admins

# ---- Study ----
#NEW_CARDS_PER_SESSION=20
