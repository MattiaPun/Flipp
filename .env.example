# ---- Server ----
# Port the container listens on.
PORT=3000
# Public URL users reach Flipp at (no trailing slash). Used for the OIDC redirect URI, passkeys (WebAuthn
# relying party), links in emails, CSRF origin checks and the cookie Secure flag. Set this behind a reverse proxy.
PUBLIC_URL=https://flipp.example.com
# Which proxies to trust for X-Forwarded-* (Express "trust proxy" syntax).
# Default trusts loopback + private networks (typical Docker / LAN reverse proxy).
#TRUST_PROXY=loopback, linklocal, uniquelocal
# Instance time zone for daily jobs (maintenance, scheduled backups).
# Each user's own streaks, reminders and daily limits use their browser's time zone automatically.
TZ=UTC

# ---- Storage ----
# Empty = embedded SQLite in WAL mode at /data/Flipp.db (uploads in /data/uploads, backups in /data/backups).
# For PostgreSQL: postgres://user:password@host:5432/flipp
DATABASE_URL=
#DATA_DIR=/data

# ---- Security ----
# Long random string; keys session hashes, signs login state and encrypts stored 2FA secrets.
# Generate with: openssl rand -hex 32. Keep it the same when restoring backups on another server.
# If empty, a secret is generated and stored in the database on first boot.
JWT_SECRET=
# First-run setup token. If empty, a one-time token is generated and printed in the container logs.
#SETUP_TOKEN=
# How long the audit log is kept.
#AUDIT_RETENTION_DAYS=365

# ---- Accounts ----
# false = only invite links, admin-created accounts, or SSO can onboard new users.
# Admins can also flip this at runtime from Admin → Access.
ALLOW_REGISTRATION=true

# ---- Email (optional: password reset, emailed invites, email confirmation) ----
# Any SMTP server, e.g. smtps://user:password@smtp.example.com:465 or smtp://user:password@mail:587
SMTP_URL=
MAIL_FROM=Flipp <flipp@example.com>

# ---- OpenID Connect (optional) ----
# Works with Authentik, Authelia, Keycloak, Google, Zitadel, … Redirect URI to register at the IdP:
#   ${PUBLIC_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Label for the login button ("Continue with …").
OIDC_NAME=SSO
# client_secret_basic (default) or client_secret_post
#OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Create accounts for unknown SSO users (default true). false = SSO only for pre-existing / linked users.
#OIDC_ALLOW_SIGNUP=true
# Users whose "groups" claim contains this value become admins (add the "groups" scope if your IdP needs it).
#OIDC_ADMIN_GROUP=flipp-admins

# ---- Limits ----
# Max size of an uploaded Anki deck or course export, and of an uploaded backup to restore.
#MAX_IMPORT_MB=300
#MAX_RESTORE_MB=4096
